# Copy to .env and fill in. Real environment variables override these.

# Optional: free key from https://api.census.gov/data/key_signup.html
# Adds the "Household income over time" chart (2010-14 -> 2015-19 -> 2020-24).
CENSUS_API_KEY=

# Who is harvesting: sent in the User-Agent of every data request so publishers can reach you.
# Example: KDASH_CONTACT=Your Name, Kannapolitan, you@example.com
KDASH_CONTACT=
